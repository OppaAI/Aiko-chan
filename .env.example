# Aiko private environment values
#
# Keep only private tokens/keys here. Non-secret runtime settings live in config/*.yaml.
#

# Apps secrets
# GITHUB_TOKEN:
#   GitHub personal access token used by core/reflect.py to publish Hugo posts.
#   Create one in GitHub Developer settings with access to the target blog repo.
GITHUB_TOKEN=<Your GitHub token>

# HF_TOKEN:
#   Hugging Face token for private/gated model downloads or model upload/update flows.
#   Create one at huggingface.co/settings/tokens when needed.
HF_TOKEN=<Your HuggingFace token>

# SEARXNG_SECRET:
#   Secret that matches your SearXNG instance configuration.
#   Copy it from searxng/settings.yml or the deployed SearXNG settings file.
SEARXNG_SECRET=<SearXNG Secret key>

# Social Media secrets
#
# IMAGEGEN_URL:
#   Image generation API endpoint; blank disables/forces fallback where code permits.
IMAGEGEN_URL=<Image generation endpoint>

# AISA_API_KEY:
#   API key for the AIsa Twitter/X relay used by core/social.py.
#   Get it from your AIsa account/dashboard for the relay service you use.
AISA_API_KEY=<Your AISA key>

# THREADS_USER_ID:
#   Numeric Meta Threads user ID that THREADS_ACCESS_TOKEN authenticates as.
#   Used by core/social.py alongside the access token for the two-step
#   container/publish flow. Find it via the Threads API /me endpoint or your
#   Meta app's Graph API Explorer while testing the token below.
#
# THREADS_ACCESS_TOKEN:
#   Long-lived Meta Threads user access token used by core/social.py.
#   Generate through your Meta app / Threads API authorization flow, then refresh before expiry.
#
# IMGBB_API_KEY:
#   ImgBB API key used by core/social.py to host generated draft images for Threads.
#   Create one in your ImgBB account API settings; Threads requires a public image URL.
#
THREADS_USER_ID=<Threads User ID>
THREADS_ACCESS_TOKEN=<Threads Access Token>
IMGBB_API_KEY=<Your ImgBB API key>

# PIXELSET_INSTANCE / PIXELSET_ACCESS_TOKEN:
#   Pixelset instance and access token for Lane B photo posting via MCP.
#   PIXELSET_* names are required; old provider-specific fallbacks are intentionally not used.
PIXELSET_INSTANCE=<https://your-pixelset-instance>
PIXELSET_ACCESS_TOKEN=<Your Pixelset Access Token>
# PIXELSET_MEDIA_ROOTS:
#   Optional comma-separated approved local roots for Pixelset uploads. Defaults to the active user social/photo workspace.
PIXELSET_MEDIA_ROOTS=

# AIKO_MESSENGER_ADAPTERS:
#   Comma-separated two-way messenger adapters to run headlessly beside WebUI/CLI.
#   Supported values: discord,telegram,slack,matrix.
AIKO_MESSENGER_ADAPTERS=discord,telegram

# Lane A1 Patreon dev-post syndication:
#   Fetch newest Patreon post weekly, save review bundle, post full body to Reddit/Hugo,
#   and teaser fanout via MCP post_social.
PATREON_LATEST_POST_URL=
#   PATREON_CREATOR_ACCESS_TOKEN and PATREON_CAMPAIGN_ID are also required
#   when PATREON_LATEST_POST_URL is not set; define them once in the OAuth section below.
AIKO_DEV_GITHUB_REPO=OppaAI/aiko-dev
AIKO_DEV_GITHUB_BRANCH=main
AIKO_DEV_HUGO_CONTENT_PATH=content/posts
A1_FULL_PROVIDERS=reddit
A1_TEASER_PROVIDERS=x,bluesky,mastodon,discord,threads
A1_REDDIT_SUBREDDIT=OppaAI

# Lane D tech job RSS draft settings:
#   Feed URLs are comma-separated. Defaults use CivicJobs.ca RSS and a Job Bank Canada filtered RSS URL.
#   TECH_JOB_KEYWORDS filters RSS titles/summaries to tech-related postings only.
#   MAX_JOBS_PER_DRAFT controls how many teaser-list entries are included in the single daily draft.
TECH_JOB_RSS_FEEDS=https://www.civicjobs.ca/rss/region?id=9&region=Lower+Mainland+-+BC,https://www.jobbank.gc.ca/jobsearch/feed/jobSearchRSSfeed?d=250&fage=2&mid=39070&sort=D&rows=100&fskl=%C2%AC15141&fcat=1
TECH_JOB_KEYWORDS=software,developer,programmer,engineer,devops,cloud,data,database,systems,network,cybersecurity,security,information technology,web,frontend,backend,full stack,qa,quality assurance,technical support
MAX_JOBS_PER_DRAFT=5

# YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET:
#   YouTube Data API v3 OAuth 2.0 credentials from Google Cloud Console.
#   Required alongside YOUTUBE_REFRESH_TOKEN below for video uploads.
#
# YOUTUBE_REFRESH_TOKEN:
#   Long-lived OAuth refresh token for YouTube uploads. Generated once via
#   the one-time browser consent flow — after that, uploads go straight
#   through without manual approval.
#
YOUTUBE_CLIENT_ID=<Your YouTube Client ID>
YOUTUBE_CLIENT_SECRET=<Your YouTube Client Secret>
YOUTUBE_REFRESH_TOKEN=<Your YouTube refresh token>

# Messaging / Social Adapter secrets
#
# DISCORD_BOT_TOKEN:
#   Discord bot token from Discord Developer Portal > Applications > Bot.
#   Used by interface/adapter/discord.py to run the Discord bot.
#
DISCORD_BOT_TOKEN=<Your Discord Bot Token>

# TELEGRAM_BOT_TOKEN:
#   Telegram bot token from @BotFather.
#   Used by interface/adapter/telegram.py to run the Telegram bot.
#
TELEGRAM_BOT_TOKEN=<Your Telegram Bot Token>

# Twitter/X API credentials (tweepy / API v2):
#   Requires a Twitter Developer Account with Elevated access.
#   TWITTER_BEARER_TOKEN  — OAuth 2.0 Bearer Token for reading mentions
#   TWITTER_API_KEY       — OAuth 1.0a API Key (Consumer Key)
#   TWITTER_API_SECRET    — OAuth 1.0a API Secret (Consumer Secret)
#   TWITTER_ACCESS_TOKEN  — OAuth 1.0a Access Token
#   TWITTER_ACCESS_SECRET — OAuth 1.0a Access Token Secret
#
TWITTER_BEARER_TOKEN=<Your Twitter Bearer Token>
TWITTER_API_KEY=<Your Twitter API Key>
TWITTER_API_SECRET=<Your Twitter API Secret>
TWITTER_ACCESS_TOKEN=<Your Twitter Access Token>
TWITTER_ACCESS_SECRET=<Your Twitter Access Secret>

# Slack bot credentials (Socket Mode):
#   SLACK_BOT_TOKEN  — xoxb-* token from Slack App > OAuth & Permissions
#   SLACK_APP_TOKEN  — xapp-* token from Slack App > Socket Mode (must be enabled)
#
SLACK_BOT_TOKEN=<Your Slack Bot Token>
SLACK_APP_TOKEN=<Your Slack App Token>

# Matrix credentials:
#   MATRIX_HOMESERVER — e.g. https://matrix.org
#   MATRIX_USER       — @user:homeserver.tld (full Matrix ID)
#   MATRIX_PASSWORD   — account password
#   MATRIX_DEVICE_ID  — optional, custom device name (default: aiko-adapter)
#
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER=<@user:homeserver.tld>
MATRIX_PASSWORD=<Your Matrix Password>
MATRIX_DEVICE_ID=aiko-adapter

# Bluesky credentials:
#   BLUESKY_HANDLE   — your Bluesky handle (e.g. myhandle.bsky.social)
#   BLUESKY_APP_PASS — App password from Settings > App Passwords
#
BLUESKY_HANDLE=<your-handle.bsky.social>
BLUESKY_APP_PASS=<Your Bluesky App Password>

# Mastodon credentials:
#   MASTODON_INSTANCE    — your instance URL (default: https://mastodon.social)
#   MASTODON_ACCESS_TOKEN — access token from Preferences > Development
#
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=<Your Mastodon Access Token>

# Reddit credentials (script app):
#   Create at https://www.reddit.com/prefs/apps (script app type)
#   REDDIT_CLIENT_ID     — the ID under the app name
#   REDDIT_CLIENT_SECRET — the secret
#   REDDIT_USERNAME      — bot account username
#   REDDIT_PASSWORD      — bot account password
#   REDDIT_USER_AGENT    — e.g. "Aiko-chan bot v0.1 by u/yourname"
#
REDDIT_CLIENT_ID=<Your Reddit Client ID>
REDDIT_CLIENT_SECRET=<Your Reddit Client Secret>
REDDIT_USERNAME=<Your Reddit Username>
REDDIT_PASSWORD=<Your Reddit Password>
REDDIT_USER_AGENT=Aiko-chan adapter v0.1

# OAuth secrets
# ALLOWED_GITHUB_USERS:
#   Owner/contributor allowlist checked in auth.py after GitHub OAuth callback.
#   Comma-separated GitHub usernames. Only listed users (or, if
#   CONTRIBUTORS_ENABLED=true, confirmed repo contributors) get a session
#   cookie — everyone else who successfully logs in via GitHub still gets a 403.
# ALLOWED_PATREON_USERS:
#   Owner allowlist for Patreon login, checked in auth.py before the
#   active-patron check. Comma-separated numeric Patreon user IDs — get yours
#   by logging in once, checking the 403 error, or logging user_id in
#   patreon_callback temporarily. Users on this list skip the patron_status
#   check entirely (so you don't have to pay yourself).
ALLOWED_GITHUB_USERS=<Your Github Username>
ALLOWED_PATREON_USERS=<Your Patreon numeric user ID>

# CONTRIBUTORS_ENABLED / GITHUB_REPO:
#   When CONTRIBUTORS_ENABLED=true, GitHub login also succeeds for anyone with
#   a commit on GITHUB_REPO (checked live against the GitHub API), not just
#   ALLOWED_GITHUB_USERS. Leave false until you're ready to open access up.
CONTRIBUTORS_ENABLED=false
GITHUB_REPO=OppaAI/Aiko-chan

# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET:
#   OAuth app credentials from GitHub Developer settings > OAuth Apps.
#   Authorization callback URL must be set there to match REDIRECT_BASE below,
#   e.g. https://aiko.ide-chroma.ts.net/auth/github/callback.
#
GITHUB_CLIENT_ID=<Your Github Client ID>
GITHUB_CLIENT_SECRET=<Your Github Client Secret>

# PATREON_CLIENT_ID / PATREON_CLIENT_SECRET:
#   OAuth app credentials from patreon.com/portal/registration/register-clients.
#   Redirect URI there must match REDIRECT_BASE/auth/patreon/callback.
#
# PATREON_CREATOR_ACCESS_TOKEN:
#   Creator access token from the same Patreon client registration page,
#   used by auth.py to look up campaign membership/patron status.
#
# PATREON_CAMPAIGN_ID:
#   Your numeric Patreon campaign ID, found on your creator dashboard URL.
#
PATREON_CLIENT_ID=<Your Patreon Client ID>
PATREON_CLIENT_SECRET=<Your Patreon Client Secret>
PATREON_CREATOR_ACCESS_TOKEN=<Your Patreon Creator Access Token>
PATREON_CAMPAIGN_ID=<Your Patreon Campaign ID>

# REDIRECT_BASE:
#   Base URL OAuth providers redirect back to after login. Must exactly match
#   what's registered in each provider's OAuth app settings (scheme+host+port).
#   Update this (and the provider dashboards) when you move hosts.
#
# SECRET_KEY:
#   Signing key for session cookies (auth.py uses itsdangerous to sign the
#   session payload directly into the cookie — no server-side session store,
#   so sessions survive process restarts/Jetson reboots). Generate once with:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
#   Treat like a password — rotating it instantly logs everyone out.
#
# TERMS_STORE_PATH (optional):
#   Where auth.py persists which users have accepted which TERMS_VERSION.
#   Defaults to ./terms_acceptance.json if unset.
#
REDIRECT_BASE=https://aiko.ide-chroma.ts.net
SECRET_KEY=<Generate a key — see command above>
TERMS_STORE_PATH=terms_acceptance.json

# SQLITE_ENCRYPTION / DATA_KEY_SECRET:
#   Optional memory DB encryption. Requires a SQLCipher-capable Python driver
#   in the runtime image. Generate the data key once with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   Store only in .env / Modal secrets / secret manager, never in YAML committed to git.
#
SQLITE_ENCRYPTION=0
DATA_KEY_SECRET="<Generate a separate data encryption secret>"

# IMAGEGEN_URL:
#   Image generation API endpoint; blank disables/forces fallback where code permits.
#
IMAGEGEN_URL=""

# ── Social MCP Server ──────────────────────────────────────────────────────
#
# SOCIAL_MCP_HOST / SOCIAL_MCP_PORT:
#   Where the social MCP server listens. Defaults to 127.0.0.1:8100.
#   SOCIAL_MCP_URL is used by Aiko's MCP client to connect (same default).
#
# SOCIAL_MCP_HOST=127.0.0.1
# SOCIAL_MCP_PORT=8100
# SOCIAL_MCP_URL=http://127.0.0.1:8100
#
# SOCIAL_MCP_DB_PATH:
#   Path to the MCP server's SQLite DB (access token cache, idempotency,
#   rate-limit counters, execution log). Defaults to mcp/social/mcp.social.db.
#   Encrypted with SQLCipher when SQLITE_ENCRYPTION=1 and DATA_KEY_SECRET is set.
#
# SOCIAL_MCP_DB_PATH=

# ── Discord posting (1-way via MCP) ───────────────────────────────────────
# Set either DISCORD_POST_WEBHOOK_URL (simpler) or DISCORD_BOT_TOKEN +
# DISCORD_POST_CHANNEL_ID (if you already have a bot).
# DISCORD_POST_WEBHOOK_URL=<channel webhook URL>
# DISCORD_POST_CHANNEL_ID=<channel ID for bot posting>
# DISCORD_API_BASE=https://discord.com/api/v10

# ── Gmail API (1-way via MCP) ──────────────────────────────────────────────
# OAuth 2.0 credentials from Google Cloud Console (Gmail API enabled).
# Same pattern as YouTube: one-time consent → refresh token.
# GMAIL_CLIENT_ID=<Google OAuth client ID>
# GMAIL_CLIENT_SECRET=<Google OAuth client secret>
# GMAIL_REFRESH_TOKEN=<OAuth refresh token>

# ── Outlook / Microsoft Graph API (1-way via MCP) ──────────────────────────
# OAuth 2.0 credentials from Azure AD App Registration.
# OUTLOOK_CLIENT_ID=<Azure AD client ID>
# OUTLOOK_CLIENT_SECRET=<Azure AD client secret>
# OUTLOOK_REFRESH_TOKEN=<OAuth refresh token>
# OUTLOOK_TENANT=common

