{
  "rss_feeds": [
    "https://remoteok.io/remote-dev-jobs.rss",
    "https://weworkremotely.com/categories/remote-programming-jobs.rss",
    "https://jobs.github.com/positions.rss?description=software+engineer&location=california",
    "https://rss.indeed.com/rss?q=software+engineer&l=California",
    "https://rss.indeed.com/rss?q=devops&l=California",
    "https://rss.indeed.com/rss?q=data+scientist&l=California"
  ],
  "date_range_days": 2,
  "max_rss_posts": 10,
  "max_rss_chars": 15000,
  "max_workers": 2,
  "job_keywords": [
    "software",
    "developer",
    "programmer",
    "engineer",
    "devops",
    "cloud",
    "data",
    "database",
    "systems",
    "network",
    "cybersecurity",
    "security",
    "information technology",
    "web",
    "frontend",
    "backend",
    "full stack",
    "qa",
    "quality assurance",
    "technical support",
    "machine learning",
    "ai",
    "kubernetes",
    "aws",
    "gcp",
    "azure",
    "react",
    "python",
    "go",
    "rust",
    "typescript"
  ],
  "fetch_job_page": true,
  "include_email": true,
  "email_source": {
    "enabled": true,
    "note": "Job alerts from LinkedIn / Glassdoor / Indeed are read via the existing Proton Mail MCP tool (read_protonmail). Mailbox credentials are configured separately."
  },
  "email_subject_keywords": [
    "job",
    "appl",
    "opportunit",
    "hiring",
    "position",
    "career",
    "vacanc",
    "job alert",
    "new job",
    "now hiring"
  ],
  "email_date_range_days": 7,
  "email_max_messages": 10,
  "max_email_posts": 10,
  "email_folder": "inbox",
  "email_source_domains": [
    "linkedin",
    "glassdoor",
    "indeed"
  ],
  "max_email_chars": 10000,
  "topic_tag": "California",
  "post_fields": [
    {
      "label": "Job Post - ",
      "key": "date"
    },
    {
      "label": "Organization: ",
      "key": "organization"
    },
    {
      "label": "Position: ",
      "key": "title"
    },
    {
      "label": "Type: ",
      "key": "employment_type"
    },
    {
      "label": "Location: ",
      "key": "location"
    },
    {
      "label": "Salary: ",
      "key": "salary"
    },
    {
      "label": "Experience: ",
      "key": "experience"
    },
    {
      "label": "Close: ",
      "key": "close_date"
    },
    {
      "label": "",
      "key": ""
    },
    {
      "label": "See details at:\n",
      "key": "url"
    }
  ],
  "post_signature": "- 𝘨𝘦𝘯'𝘥 𝘣𝘺 𝘈𝘪𝘬𝘰 (𝘖𝘱𝘱𝘰𝘈𝘐'𝘴 𝘈𝘐 𝘈𝘨𝘦𝘯𝘵)",
  "include_remote": true,
  "min_salary_hourly": 50,
  "min_salary_annual": 100000,
  "max_results": 30,
  "dedup_days": 3,
  "cache_fetch_minutes": 30,
  "auto_post": false,
  "workflow_id": "job_hunt",
  "sources": [
    {
      "type": "adapter",
      "id": "job_hunt",
      "name": "job_hunt"
    }
  ],
  "human_in_the_loop": true,
  "llm_enriched": true,
  "retain_days": 3,
  "email": {
    "enabled": false
  },
  "social": []
}
